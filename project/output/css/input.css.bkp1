@import "tailwindcss";


@theme {
  --color-trueblack: #243131;
  --color-truewhite: oklch(98.4% 0.003 247.858);
  --color-trueblue: #005eac;
  --color-trueyellow: #fad13e;
  --color-truered: #df4c40;
  --color-accent: var(--color-truered);
  --color-hover: var(--color-trueyellow);
  --color-active: var(--color-trueblue);

  --spacing-myspace-2xl: 2.5rem;
  --spacing-myspace-xl: 2rem;
  --spacing-myspace-lg: 1.75rem;
  --spacing-myspace: 1.5rem;
  --spacing-myspace-md: 1.25rem;
  --spacing-myspace-sm: 1rem;
  --spacing-myspace-xs: 0.875rem;
}



* {
  box-sizing: border-box;
  url('https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;700&family=Inter:wght@100..900&display=swap');
}

@layer components {
  .button.button-primary,
  a.button.button-primary,
  button.button-primary,
  input[type="submit"].button-primary,
  input[type="reset"].button-primary,
  input[type="button"].button-primary {
    margin-top: var(--spacing-myspace);
    margin-bottom: var(--spacing-myspace);
    color: var(--color-accent);
    background-color: rgba(var(--color-truewhite), 0.8);
    border: 1px solid var(--color-accent);
    outline-color: var(--color-trueblue);
    outline-offset: 1px;
    font-family: 'Inter', sans-serif;
    display: inline-block;
    height: 38px;
    padding: 0 30px;
    text-align: center;
    font-size: 11px;
    font-weight: 600;
    line-height: 38px;
    letter-spacing: 0.1rem;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    border-radius: 4px;
    cursor: pointer;
    box-sizing: border-box;
  }

  .button.button-primary:hover,
  a.button.button-primary:hover,
  button.button-primary:hover,
  input[type="submit"].button-primary:hover,
  input[type="reset"].button-primary:hover,
  input[type="button"].button-primary:hover {
    color: var(--color-truewhite);
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .button.button-primary:active,
  a.button.button-primary:active,
  button.button-primary:active,
  input[type="submit"].button-primary:active,
  input[type="reset"].button-primary:active,
  input[type="button"].button-primary:active {
    background-color: var(--color-trueyellow);
    border-color: var(--color-trueyellow);
    color: var(--color-trueblue);
  }

  .button.button-primary:focus,
  a.button.button-primary:focus,
  button.button-primary:focus,
  input[type="submit"].button-primary:focus,
  input[type="reset"].button-primary:focus,
  input[type="button"].button-primary:focus {
    outline: 1px solid var(--color-trueblue);
  }
}

@layer base {
  body {
    font-family: 'Inter', sans-serif;
    @apply bg-truewhite;
  }

  .font-inter {
    font-family: 'Inter', sans-serif;
  }
  .font-garamond {
    font-family: 'EB Garamond', sans-serif;
  }

  h1,
  h2,
  h3,
  h4,
  h5 {
    color: var(--color-accent);
    font-family: 'Inter', sans-serif;
    font-weight: 800;
  }

  h1,
  h2,
  h3,
  h4,
  h5 {
    margin-bottom: var(--spacing-myspace);
  }

  p,
  ul,
  ol {
    margin-bottom: var(--spacing-myspace);
  }

  p:last-child {
    margin-bottom: 0rem;
  }

  ul:last-child {
    margin-bottom: 0rem;
  }

  ol:last-child {
    margin-bottom: 0rem;
  }

  h1:last-child {
    margin-bottom: 0rem;
  }

  h2:last-child {
    margin-bottom: 0rem;
  }

  h3:last-child {
    margin-bottom: 0rem;
  }

  h4:last-child {
    margin-bottom: 0rem;
  }

  h5:last-child {
    margin-bottom: 0rem;
  }

  a {
    @apply text-trueblue hover:text-trueblue hover:bg-trueyellow no-underline;
  }

  h1 {
    font-size: 4rem;
    @apply text-6xl leading-[3.75rem] mb-[1.25rem];
    line-height: 1;
  }

  h2 {
    margin-bottom: var(--spacing-myspace);
    font-size: var(--text-4xl);
    line-height: 1;
  }
}
